# ==============================================
# Sight Word Stories - Environment Variables
# ==============================================
# Copy this file to .env.local and fill in your actual values
# .env.local is git-ignored; keep it out of version control.

# ==============================================
# DATABASE
# ==============================================
# MongoDB connection string
# Get this from MongoDB Atlas: https://cloud.mongodb.com/
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=

# Database name inside the cluster. Recommended: without it the name comes
# from the connection string, and a string with none makes the driver use "test".
MONGODB_DB=sight-word-stories

# ==============================================
# AUTHENTICATION (NextAuth.js)
# ==============================================
# Base URL of your application
# Local development: http://localhost:3000
# Production: https://your-domain.com
NEXTAUTH_URL=http://localhost:3000

# Signs and encrypts session tokens. Use a long random value:
# openssl rand -base64 32
NEXTAUTH_SECRET=

# ==============================================
# EMAIL (Optional - for sharing stories by email)
# ==============================================
# Email goes through Resend (https://resend.com). Verify a sending domain in
# Resend first, then create an API key restricted to that domain, with the
# narrowest permission that can send.

# Resend API key
RESEND_API_KEY=

# "From" address. It must be at the domain verified in Resend; this is the
# one sightwords.sheetsolved.com uses, so change it for your own deployment.
EMAIL_FROM="Sight Word Stories <stories@sightwords.sheetsolved.com>"

# ==============================================
# NOTES
# ==============================================
# REQUIRED: MONGODB_URI, NEXTAUTH_URL, NEXTAUTH_SECRET
# OPTIONAL: RESEND_API_KEY and EMAIL_FROM (email sharing)
#
# The app runs on free tiers (MongoDB Atlas, Vercel) and draws illustrations
# as SVG. AI stories need no setting here: each grown-up adds their own
# Anthropic API key in the app, and Anthropic bills their account.
#
# Use different values for development and production.
