# ==============================================
# Sight Word Story Generator - Environment Variables
# ==============================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control!

# ==============================================
# DATABASE
# ==============================================
# MongoDB connection string
# Get this from MongoDB Atlas: https://cloud.mongodb.com/
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=

# Database name inside the cluster. Recommended: without it the name comes
# from the connection string, and a string with none makes the driver use "test".
MONGODB_DB=sight-word-stories

# ==============================================
# AUTHENTICATION (NextAuth.js)
# ==============================================
# Base URL of your application
# Local development: http://localhost:3000
# Production: https://your-domain.com
NEXTAUTH_URL=http://localhost:3000

# Secret for JWT encryption - MUST be random and secure!
# Generate one with: openssl rand -base64 32
# Or use: https://generate-secret.vercel.app/32
NEXTAUTH_SECRET=YOUR_VERY_LONG_RANDOM_SECRET_HERE_MINIMUM_32_CHARACTERS

# ==============================================
# EMAIL CONFIGURATION (Optional - For story sharing)
# ==============================================
# SMTP server configuration for sending emails
# Example values shown for Gmail - adjust for your provider

# SMTP server hostname
EMAIL_SERVER_HOST=smtp.gmail.com

# SMTP server port (587 for TLS, 465 for SSL)
EMAIL_SERVER_PORT=587

# Your email address
EMAIL_SERVER_USER=your-email@gmail.com

# Your email password or app-specific password
# For Gmail, generate an app password: https://myaccount.google.com/apppasswords
EMAIL_SERVER_PASSWORD=your-app-specific-password

# "From" address for sent emails
EMAIL_FROM="Sight Word Stories <your-email@gmail.com>"

# ==============================================
# NOTES
# ==============================================
# REQUIRED: MONGODB_URI, NEXTAUTH_URL, NEXTAUTH_SECRET
# OPTIONAL: EMAIL_* (email sharing)
#
# The app runs on free tiers (MongoDB Atlas, Vercel) and draws illustrations
# as SVG. AI stories need no setting here: each grown-up adds their own
# Anthropic API key in the app, and Anthropic bills their account.
#
# - Never share your .env.local file or commit it to Git
# - Rotate all secrets/passwords before deploying to production
# - Use different values for development and production environments
